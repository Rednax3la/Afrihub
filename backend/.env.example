# ── Core ──────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://Admin:<%40admin1234!>@cluster0.6anq7v9.mongodb.net/?appName=Cluster0
DB_NAME=vernaculearn
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://vernaculearn.vercel.app

# ── Cloudflare R2 (media storage) ─────────────────────────────────────────────
# Set R2_ENABLED=true in production. When false, files are saved locally.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vernaculearn-media
R2_PUBLIC_URL=https://media.vernaculearn.com

# ── Text-to-Speech ────────────────────────────────────────────────────────────
# ElevenLabs is the primary TTS provider. gTTS is used as a free offline fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_IDS={"yo": "voice_id_here", "sw": "voice_id_here", "zu": "voice_id_here", "am": "voice_id_here"}
TTS_FALLBACK=gtts

# Google Identity Services
GOOGLE_CLIENT_ID=

# Web Push: generate locally with python scripts/generate_vapid_keys.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=hello@vernaculearn.africa
ENABLE_STREAK_REMINDERS=true

# Test activation requires BOTH development and TEST. Keep production defaults on servers.
APP_ENV=production
GOOGLE_PAY_ENVIRONMENT=PRODUCTION
STRIPE_SECRET_KEY=

# Safaricom Daraja
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.vernaculearn.africa/api/payments/mpesa/callback
MPESA_CALLBACK_SECRET=

# Password recovery: Railway backend only. Never use VITE_ for SMTP secrets.
PASSWORD_RESET_ORIGIN=https://vernaculearn.africa
SMTP_HOST=
SMTP_PORT=
# Exactly starttls or ssl; use the provider's required port/security pairing.
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
# Bare verified sender email address (no display name).
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=10
