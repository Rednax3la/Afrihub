VITE_API_URL=http://localhost:8000
# Vercel production: VITE_API_URL=https://afrihub-production.up.railway.app
# Rebuild after changes. Recovery CSP in vercel.json must allow this API origin.
# Password recovery/SMTP settings belong only in Railway, never in VITE_ variables.
# Premium unit gating. Temporarily false: no lock icons and no upgrade modals
# for units. Set to true (and the backend's PAYWALL_ENABLED to true) to restore
# the paywall. Rebuild Vercel after changing this.
VITE_PAYWALL_ENABLED=false
# Shown in the Contact Support email body; leave blank to send "unknown".
VITE_APP_VERSION=

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PAY_MERCHANT_ID=
VITE_GOOGLE_PAY_ENVIRONMENT=TEST
# Production Google Pay uses Stripe tokenization and matching backend credentials.
VITE_STRIPE_PUBLISHABLE_KEY=
