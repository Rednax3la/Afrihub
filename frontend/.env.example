VITE_API_URL=http://localhost:8000
# Vercel production: VITE_API_URL=https://afrihub-production.up.railway.app
# Rebuild after changes. Recovery CSP in vercel.json must allow this API origin.
# Password recovery/SMTP settings belong only in Railway, never in VITE_ variables.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PAY_MERCHANT_ID=
VITE_GOOGLE_PAY_ENVIRONMENT=TEST
# Production Google Pay uses Stripe tokenization and matching backend credentials.
VITE_STRIPE_PUBLISHABLE_KEY=
